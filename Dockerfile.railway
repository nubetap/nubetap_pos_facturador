FROM php:8.2-cli

# Instalar dependencias del sistema (incluyendo librerías para GD, QR codes, y PDFs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libpq-dev \
    libzip-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libwebp-dev \
    libicu-dev \
    zip \
    unzip \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Configurar extensión GD con soporte para imágenes (necesario para dompdf y QR codes)
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-configure pgsql -with-pgsql=/usr/local/pgsql \
    && docker-php-ext-configure intl

# Instalar extensiones PHP (incluyendo GD para PDFs/QR codes)
RUN docker-php-ext-install -j$(nproc) \
    pdo \
    pdo_pgsql \
    pgsql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    soap \
    intl \
    opcache

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar directorio de trabajo
WORKDIR /var/www/html

# Copiar archivos del proyecto
COPY . .

# Instalar dependencias PHP
RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist

# Instalar dependencias Node.js y compilar assets
RUN npm install && npm run build

# Crear directorios y permisos
RUN mkdir -p storage/app/public/certificado \
    storage/app/sunat \
    storage/logs \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Railway inyecta PORT como variable de entorno
ARG PORT=8080
ENV PORT=${PORT}

# Exponer puerto dinámico
EXPOSE ${PORT}

# Comando de inicio
CMD ["bash", "railway-start.sh"]
