# APP Configuration
APP_NAME="API Facturación SUNAT - Docker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sunat_api
DB_USERNAME=sunat_user
DB_PASSWORD=sunat_password

# Cache & Session
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
CACHE_STORE=redis
CACHE_PREFIX=sunat_
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8001,127.0.0.1:8001
SANCTUM_EXPIRATION=1440
SANCTUM_MAX_TOKENS=10

# SUNAT Configuration
SUNAT_ENVIRONMENT=beta
SUNAT_CERTIFICATE_PATH=storage/app/public/certificado/certificado.pem
SUNAT_CERTIFICATE_PASSWORD=

# File Storage
FILES_STORAGE_PATH=storage/app/sunat
FILES_MAX_SIZE=10240

# Mail (opcional)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Docker
USER_ID=1000
GROUP_ID=1000

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Vite
VITE_APP_NAME="${APP_NAME}"
